[Unit]
Description=Fuel Patrol Next.js Client
After=network.target
Requires=network.target

[Service]
User=root
Group=root

WorkingDirectory=/root/dev/fuel_patrol_client

Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="HOSTNAME=0.0.0.0"

Environment="PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/node/bin"

ExecStart=/usr/bin/npm run dev

Restart=always
RestartSec=10

LimitNOFILE=65536
LimitNPROC=512

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWriteDirectories=/root/dev/fuel_patrol_client
ReadOnlyDirectories=/
ProtectHome=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fuel-patrol-client

[Install]
WantedBy=multi-user.target